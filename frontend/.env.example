# Base URL the browser uses for API calls.
# Default "/api" works with the Vite dev proxy (npm run dev) and the nginx proxy (Docker).
# Set an absolute URL (e.g. http://localhost:8080/api) only to call the backend directly (CORS must allow it).
VITE_API_BASE_URL=/api

# Dev-server only: where the Vite proxy forwards /api (defaults to http://localhost:8080).
# VITE_PROXY_TARGET=http://localhost:8080
