# Copy to .env (or export these directly) for local development. Never commit the real .env —
# these are placeholder values only, matching application.yml's defaults. See AGENTS.md §27 and
# KNOWN_LIMITATIONS.md "Deferred / assumptions" (default secrets are a known, accepted gap for a
# demo/assignment environment — rotate every one of these before any real deployment).

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5433/order_inventory
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- Redis (refresh-token/session data + dashboard + role-permission caches) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- RabbitMQ (event bus behind the Transactional Outbox — see docs/DESIGN_PATTERNS.md) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- JWT (RS256; the keypair itself is generated on first boot into JWT_KEYSTORE_PATH, not set here) ---
JWT_KEYSTORE_PATH=./keys
JWT_KEY_PASSPHRASE=changeit
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS ---
# Comma-separated allowed origins, or "*" for any (not recommended past a demo).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server ---
SERVER_PORT=8080
